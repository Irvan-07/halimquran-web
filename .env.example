# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scalev — API v3, base URL https://api.scalev.com (hardcoded in
# lib/scalev/client.ts, verified against https://dev.scalev.com 25 Sep
# 2026). No key exists on the account yet (Settings > Developers > API
# Keys). Two DIFFERENT key types — do not conflate them:
# SCALEV_API_KEY: business routes (Authorization: Bearer), e.g. products/orders.
# SCALEV_STOREFRONT_API_KEY: public/guest routes (X-Scalev-Storefront-Api-Key), e.g. cart/checkout.
# SCALEV_STORE_ID: required to scope storefront routes (/v3/stores/{id}/public/...).
SCALEV_API_KEY=
SCALEV_STOREFRONT_API_KEY=
SCALEV_STORE_ID=

# Analytics — event layer scaffolded (lib/analytics/, components/tracking/)
# and already wired at view_item/add_to_cart/begin_checkout, but everything
# no-ops until NEXT_PUBLIC_GTM_ID is set. Leave empty until the GTM
# container-ownership conflict (GTM-WRJ5MLS vs GTM-595C69F, see plan) is
# resolved — do not guess which one is correct.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
