# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scalev — API v3, base URL https://api.scalev.com (hardcoded in
# lib/scalev/client.ts, verified against https://dev.scalev.com 25 Sep
# 2026). Two DIFFERENT auth families — do not conflate them:
#
# SCALEV_API_KEY: business routes (Authorization: Bearer), e.g. product/order
# read. SECRET — server-only (lib/scalev/client.ts, `import "server-only"`).
# Created in Settings > Developers > API Keys, type "Restricted".
#
# NEXT_PUBLIC_SCALEV_STOREFRONT_API_KEY / NEXT_PUBLIC_SCALEV_STORE_ID:
# storefront routes (X-Scalev-Storefront-Api-Key), e.g. guest cart/checkout.
# PUBLISHABLE (prefix sfpk_) — Scalev's docs require calling these directly
# from the browser, not proxied through our server, so these are
# intentionally NEXT_PUBLIC_ (see lib/scalev/storefront-client.ts). Store ID
# is the store's `unique_id` (e.g. store_xxxxx), not the numeric dashboard
# URL id. Configured in the dashboard's Store page > Storefront API section.
# Only works when the Scalev subscription plan is an active Basic/Pro/
# Ultimate — an unpaid/inactive plan returns "Store not found" regardless of
# key validity.
SCALEV_API_KEY=
NEXT_PUBLIC_SCALEV_STOREFRONT_API_KEY=
NEXT_PUBLIC_SCALEV_STORE_ID=

# Analytics — event layer scaffolded (lib/analytics/, components/tracking/)
# and already wired at view_item/add_to_cart/begin_checkout, but everything
# no-ops until NEXT_PUBLIC_GTM_ID is set. Leave empty until the GTM
# container-ownership conflict (GTM-WRJ5MLS vs GTM-595C69F, see plan) is
# resolved — do not guess which one is correct.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
