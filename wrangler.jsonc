{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "halimquran-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "halimquran-web" }],
  // Page/ISR cache (Next's incremental cache). Workers Paid, so no tight KV
  // write quota: the catalog revalidates at the default 60 s
  // (SCALEV_REVALIDATE_SECONDS can still override it).
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "83911550f83b4977b5c10eed50ed16ed" }]
}
